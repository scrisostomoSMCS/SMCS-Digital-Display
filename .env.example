# Environment variables template.
# Copy to `.env.local` and fill in real values.
# Next.js reads env only at startup, so restart the dev server after editing.
# Never commit `.env.local` (it is gitignored) and never paste real values here.

# --- Supabase (from Supabase: Settings -> API) -----------------------------
# Both are public on purpose: they ship to the browser, and access is
# restricted by Row Level Security, not by hiding these keys.
# NEVER put the service_role / secret key in a NEXT_PUBLIC_ variable.

# "Project URL", e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (sb_publishable_...) or the legacy "anon" public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auto-translation (English -> Spanish on save) --------------------------
# All server-only: never prefix these with NEXT_PUBLIC_.
# Which provider translate-on-save uses: "azure" (default) or "mymemory".
TRANSLATION_PROVIDER=azure

# Azure Translator (Azure portal: your Translator resource -> Keys and Endpoint).
# The key is required; without it saves still succeed but show an
# "auto-translate failed" warning.
AZURE_TRANSLATOR_KEY=
# "Location/Region" of the resource, e.g. eastus. Required for regional or
# multi-service resources; leave empty for a global resource.
AZURE_TRANSLATOR_REGION=
# Optional; defaults to the global endpoint below.
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# MyMemory (only used when TRANSLATION_PROVIDER=mymemory). Email for its
# registered mode, which raises the daily quota (~5,000 -> ~50,000 words).
# If unset, MyMemory falls back to anonymous mode automatically.
MYMEMORY_EMAIL=

# --- Not used by any code today --------------------------------------------
# Direct Postgres connection string. Nothing in the app reads this; leave it
# commented out unless a future Prisma/direct-SQL integration needs it.
# DATABASE_URL=
